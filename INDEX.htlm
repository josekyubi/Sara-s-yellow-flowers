<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para ti ❤️</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #fce4ec; /* Un color de fondo suave */
            overflow: hidden;
            font-family: 'Arial', sans-serif;
            color: #4a4a4a;
        }

        .container {
            position: relative;
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }

        .message-box {
            position: relative;
            z-index: 10;
            text-align: center;
            animation: fadeInMessage 3s forwards;
            opacity: 0;
            transform: translateY(20px);
            padding: 20px;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .message {
            font-size: 3em;
            font-weight: bold;
            color: #e91e63;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
            margin: 0;
            font-style: italic;
        }

        .flower {
            position: absolute;
            font-size: 2em;
            color: #ffc107; /* Amarillo de las flores */
            animation: floatUp 15s infinite ease-in-out, rotateFlower 10s infinite linear;
            opacity: 0;
        }

        .flower-2 {
            animation-delay: 2s;
            left: 10%;
            top: 80%;
        }

        .flower-3 {
            animation-delay: 4s;
            left: 70%;
            top: 50%;
        }

        .flower-4 {
            animation-delay: 6s;
            left: 40%;
            top: 20%;
        }

        .flower-5 {
            animation-delay: 8s;
            left: 90%;
            top: 70%;
        }

        @keyframes fadeInMessage {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes floatUp {
            0% {
                transform: translateY(100vh) rotate(0deg);
                opacity: 0;
            }
            50% {
                opacity: 1;
            }
            100% {
                transform: translateY(-100vh) rotate(360deg);
                opacity: 0;
            }
        }

        @keyframes rotateFlower {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="message-box">
            <h1 class="message">Te quiero muchísimo</h1>
        </div>
    </div>

    <span class="flower" style="left: 20%; top: 90%;">🌼</span>
    <span class="flower flower-2" style="left: 80%; top: 50%;">🌻</span>
    <span class="flower flower-3" style="left: 50%; top: 30%;">🌼</span>
    <span class="flower flower-4" style="left: 15%; top: 60%;">🌻</span>
    <span class="flower flower-5" style="left: 60%; top: 85%;">🌼</span>

</body>
</html>
